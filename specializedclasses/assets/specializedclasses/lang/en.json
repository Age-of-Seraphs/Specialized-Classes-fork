	// specializedclasses: crafting traits [#99d6ff]
	"game:trait-archivist": "<font color=\"#99d6ff\">• Archivist </font>",
	"game:traitname-archivist": "Archivist",
	"game:traitdesc-archivist": "<a href=\"handbook://specializedclasses:class-archivist\">Can recycle clutter into rot, can recycle lore items into parchment, can use rot to make aged wooden and stone building blocks, can make paper lanterns, and can craft the unique scroll case backpack</a>",

	"game:trait-blackguard": "<font color=\"#99d6ff\">• Blackguard </font>",
	"game:traitname-blackguard": "Blackguard",
	"game:traitdesc-blackguard": "<a href=\"handbook://specializedclasses:class-blackguard\">Can forge broken blackguard armor from scrap, can make cheaper forges and bellows, and has access to the brass swage block, to craft metal bits into metal crafting components in bulk</a>",

	"game:trait-brickmaker": "<font color=\"#99d6ff\">• Brickmaker </font>",
	"game:traitname-brickmaker": "Brickmaker",
	"game:traitdesc-brickmaker": "<a href=\"handbook://specializedclasses:class-brickmaker\">Can form clay into bricks, shingles and tiles in bulk using molds, can obtain lime more efficiently, and can use lime directly in mortar and plaster. Can make twice as many mudbricks and raw daub, and can craft the unique soil bag backpack</a>",

	"game:trait-butcher": "<font color=\"#99d6ff\">• Butcher </font>",
	"game:traitname-butcher": "Butcher",
	"game:traitdesc-butcher": "<a href=\"handbook://specializedclasses:class-butcher\">Can craft cheaper and earlier kitchen and ranching tools, can obtain salt more efficiently, can cure meats by hand, can create vintage beef, can cheaply craft shelf-stable universal animal feed, and can craft the unique insulated crate backpack</a>",

	"game:trait-clockmaker": "<font color=\"#99d6ff\">• Clockmaker </font>",
	"game:traitname-clockmaker": "Clockmaker",
	"game:traitdesc-clockmaker": "<a href=\"handbook://specializedclasses:class-clockmaker\">Can carve mechanical power components at double yield, can fry a base return teleporter to turn a rusty gear into a temporal gear, and can repair fried base return teleporters with any jonas part. Can use the tinkerer&apos;s workstation to make metal parts and jonas parts out of cupronickel</a>",

	"game:trait-farmhand": "<font color=\"#99d6ff\">• Farmhand </font>",
	"game:traitname-farmhand": "Farmhand",
	"game:traitdesc-farmhand": "<a href=\"handbook://specializedclasses:class-farmhand\">Can grind up fertilizer components more efficiently, can hoe charcoal, bonemeal and compost through soil to permanently improve its fertility, can make stinkbait more efficiently</a>",

	"game:trait-florist": "<font color=\"#99d6ff\">• Florist </font>",
	"game:traitname-florist": "Florist",
	"game:traitdesc-florist": "<a href=\"handbook://specializedclasses:class-florist\">Can degrade soil fertility to duplicate flowers. Can create color pigments and use them to paint paintings, vessels, flowerpots, planters, and wallpaper. Can make cheaper linen poultices, can make filled beenades. Can use the sprouting table to turn saplings and compost into leaves, and can propagate flowers with compost there as well</a>",

	"game:trait-forester": "<font color=\"#99d6ff\">• Forester </font>",
	"game:traitname-forester": "Forester",
	"game:traitdesc-forester": "<a href=\"handbook://specializedclasses:class-forester\">Can carve boards early with a knife. Can craft boards and firewood more efficiently, and can carve boards into sticks. Can create aged wooden building blocks using firewood. Can use the woodcarving table to craft unworked logs into a multitude of wooden objects and building blocks directly</a>",

	"game:trait-hunter": "<font color=\"#99d6ff\">• Hunter </font>",
	"game:traitname-hunter": "Hunter",
	"game:traitdesc-hunter": "<a href=\"handbook://specializedclasses:class-hunter\">Can turn pelts into scraped hides, and can turn soaked hides into twice as many scraped hides. Can use reeds as fletching for arrows, and carve bones into bone arrows</a>",

	"game:trait-malefactor": "<font color=\"#99d6ff\">• Malefactor </font>",
	"game:traitname-malefactor": "Malefactor",
	"game:traitdesc-malefactor": "<a href=\"handbook://specializedclasses:class-malefactor\">Can create scrap weapon kits out of stones, sticks, and grass. Can make aged torch holders out of scrap and nails, and can recycle rusty gears into metal scrap</a>",

	"game:trait-messenger": "<font color=\"#99d6ff\">• Messenger </font>",
	"game:traitname-messenger": "Messenger",
	"game:traitdesc-messenger": "<a href=\"handbook://specializedclasses:class-messenger\">Can create specialist bags, has cheaper recipes for normal bags, and exclusive access to the 10-slot messenger bag. Has cheaper recipes for lanterns, paths, and roads. Has exclusive access to the 1.5x asphalt road</a>",

	"game:trait-quarrier": "<font color=\"#99d6ff\">• Quarrier </font>",
	"game:traitname-quarrier": "Quarrier",
	"game:traitdesc-quarrier": "<a href=\"handbook://specializedclasses:class-quarrier\">Can create a variety of aged and otherwise rare stone building blocks. Can use clay instead of mortar to assemble stone bricks. Can break rock into stones, gravel, and sand, and can assemble 8 stones back into solid rock. Can use the stonecutting bench to make a multitude of stone building blocks directly</a>",

	"game:trait-spelunker": "<font color=\"#99d6ff\">• Spelunker </font>",
	"game:traitname-spelunker": "Spelunker",
	"game:traitdesc-spelunker": "<a href=\"handbook://specializedclasses:class-spelunker\">Can more efficiently process minerals like sulfur, lime, salt, borax, and salt. Can make saltpeter out of compost and lime. Can make bombs with much less linen. Can make exclusive metallic, crystalline or carbonaceous paydirt to aim for certain panning outputs. Can make rope ladders with less rope. Can make wooden posts with less wood.</a>",

	"game:trait-tailor": "<font color=\"#99d6ff\">• Tailor </font>",
	"game:traitname-tailor": "Tailor",
	"game:traitdesc-tailor": "<a href=\"handbook://specializedclasses:class-tailor\">Can craft a spindle to more effectively spin flax fibers and papyrus from grass, flax twine from flax fibers, and rope from reeds and vines</a>",

	"game:trait-vintner": "<font color=\"#99d6ff\">• Vintner </font>",
	"game:traitname-vintner": "Vintner",
	"game:traitdesc-vintner": "<a href=\"handbook://specializedclasses:class-vintner\">Can craft cheaper and earlier liquid storage and processing, can turn quartz into clear quartz, and can make bush cuttings out of berries and high fertility soil. Can use the sprouting table with compost to turn fruits into bush or tree cuttings</a>",

	"game:trait-bowyer": "<font color=\"#99d6ff\">• Bowyer </font>",
	"game:traitname-bowyer": "Bowyer",

